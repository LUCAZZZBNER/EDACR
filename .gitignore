# Collected data and local audit/provenance records are not committed to Git.
/data/
# Local credentials; commit only the example.
/config/github.yaml
.env
.env.*
!.env.example
# Downloaded upstream reference checkout (source/commit recorded in reference/*.json).
/reference/aacr-bench/
# Environments and generated caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
# Large archives and local database files.
*.tar
*.tar.gz
*.tgz
*.zip
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
